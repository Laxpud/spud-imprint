{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spud Imprint",
  "version": "0.1.0",
  "identifier": "dev.spudimprint.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Spud Imprint",
        "width": 980,
        "height": 720,
        "minWidth": 820,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
